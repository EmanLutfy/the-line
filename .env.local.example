# Copy to .env.local and fill in. .env.local is gitignored — never commit it.

# Supabase — server only. The service role key bypasses row level security,
# so it must never appear in a NEXT_PUBLIC_ variable or reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets mirror. The Web app URL from Apps Script, and the same secret
# you pasted into SHARED_SECRET in db/sheets-appscript.gs.
SHEETS_WEBHOOK_URL=
SHEETS_SHARED_SECRET=

# Shared secret for GET /api/draw/export. Any long random string.
ADMIN_EXPORT_TOKEN=


# The live domain. Without it, link previews on X resolve no image.
NEXT_PUBLIC_SITE_URL=

# The wishlist is open by default. Set to true only once a real gate exists.
WISHLIST_REQUIRE_AUTH=false

# Cloudflare Turnstile. Site key is public and inlined at build time; the
# secret key is server only. Leave both empty to run without verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
