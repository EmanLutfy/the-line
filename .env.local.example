# Copy to .env.local and fill in. .env.local is gitignored — never commit it.

# Supabase — server only. The service role key bypasses row level security,
# so it must never appear in a NEXT_PUBLIC_ variable or reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets mirror. The Web app URL from Apps Script, and the same secret
# you pasted into SHARED_SECRET in db/sheets-appscript.gs.
SHEETS_WEBHOOK_URL=
SHEETS_SHARED_SECRET=

# Shared secret for GET /api/draw/export. Any long random string.
ADMIN_EXPORT_TOKEN=


# The live domain. Without it, link previews on X resolve no image.
NEXT_PUBLIC_SITE_URL=

# The wishlist is open by default. Set to true only once a real gate exists.
WISHLIST_REQUIRE_AUTH=false

# Cloudflare Turnstile. Site key is public and inlined at build time; the
# secret key is server only. Leave both empty to run without verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------- mint page
# All public: this is what the browser needs to read the chain. No secrets here.
# Chain 4663 = Robinhood mainnet, 46630 = testnet. Testnet until it is not.
NEXT_PUBLIC_CHAIN_ID=46630

# One endpoint per network — an RPC for one chain cannot answer for the other.
# Only the chain named above is actually used; the other may stay empty.
NEXT_PUBLIC_RPC_URL_TESTNET=
NEXT_PUBLIC_RPC_URL_MAINNET=

# Contract addresses. Leave $LINE empty until the token is deployed — the mint
# page renders "MINT OPENS SOON" rather than breaking.
NEXT_PUBLIC_NFT_ADDRESS=
NEXT_PUBLIC_MINT_ADDRESS=
NEXT_PUBLIC_LINE_ADDRESS=

# OpenSea's path segment for this chain. Verify it before launch — a wrong
# slug gives a 404 at the collector's proudest moment. Empty falls back to the
# block explorer.
NEXT_PUBLIC_OPENSEA_BASE=

# The collection's page on OpenSea. Empty hides the OpenSea mark in the header
# and footer, rather than linking to a listing that does not exist yet.
NEXT_PUBLIC_OPENSEA_URL=
