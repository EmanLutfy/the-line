# Public values only. Copy to .env — which is gitignored — and fill the RPC.
# There is deliberately no PRIVATE_KEY here: the deployer key goes into an
# encrypted Foundry keystore instead, so it never sits in a file in plain text.
#
#   cast wallet import theline-deployer --interactive
#   forge script script/Deploy.s.sol:Deploy \
#     --rpc-url robinhood_testnet --account theline-deployer \
#     --sender 0xYOUR_ADDRESS --broadcast -vvvv

ROBINHOOD_TESTNET_RPC_URL=
ROBINHOOD_RPC_URL=

# The wallet that will own both contracts.
OWNER_ADDRESS=

# Served from public/collection/ on the site. Every token returns the first of
# these until reveal() is called.
UNREVEALED_URI=https://www.thelineart.xyz/collection/pre-reveal.json
CONTRACT_URI=https://www.thelineart.xyz/collection/contract.json

# From tools/prepare-collection.mjs. Fixed at deployment, immutable afterwards.
# Publish this before the mint opens — that is the entire point of it.
PROVENANCE_HASH=0x018c2227d5030b4d7ee6bc30e887b0747bb6c70b40cb37f9db9a9138d051795e
